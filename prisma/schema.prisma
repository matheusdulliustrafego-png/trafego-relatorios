datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

model Report {
  id             String   @id @default(cuid())
  cliente        String
  campanha       String   @default("")
  periodoInicio  DateTime
  periodoFim     DateTime
  investimento   Float
  alcance        Int
  impressoes     Int
  cliques        Int
  leads          Int
  observacoes    String   @default("")
  createdAt      DateTime @default(now())
}
