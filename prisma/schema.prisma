datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

model Cliente {
  id        String   @id @default(cuid())
  nome      String
  slug      String   @unique
  createdAt DateTime @default(now())
  reports   Report[]
}

model Report {
  id                  String   @id @default(cuid())
  cliente             Cliente  @relation(fields: [clienteId], references: [id])
  clienteId           String
  campanha            String   @default("")
  periodoInicio       DateTime
  periodoFim          DateTime
  investimento        Float
  alcance             Int
  impressoes          Int
  cliques             Int
  leads               Int
  visualizacoesPagina Int      @default(0)
  observacoes         String   @default("")
  createdAt           DateTime @default(now())
}
